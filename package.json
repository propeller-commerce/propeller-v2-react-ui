{
  "name": "@propeller-commerce/propeller-v2-react-ui",
  "version": "0.19.1",
  "description": "React component library for Propeller Commerce — ready-made e-commerce UI, headless composables, and SDK glue.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "STYLING.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "require": "./dist/shared.cjs"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "import": "./dist/pure.js",
      "require": "./dist/pure.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup && npm run build:css",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "npm run build:css && storybook dev -p 6006",
    "build-storybook": "npm run build:css && storybook build",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue\""
  },
  "peerDependencies": {
    "@propeller-commerce/propeller-sdk-v2": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@propeller-commerce/propeller-v2-core-ui": "^0.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.560.0",
    "marked": "^17.0.5",
    "qs": "^6.15.0",
    "react-hot-toast": "^2.6.0",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@propeller-commerce/propeller-sdk-v2": "^0.16.0",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@tailwindcss/cli": "^4",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20",
    "@types/qs": "^6.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "sideEffects": false
}
